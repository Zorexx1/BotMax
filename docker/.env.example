MAX_BOT_TOKEN=
MAX_API_URL=https://platform-api2.max.ru

# Authorization Key из кабинета GigaChat (около 100 символов, на конце обычно ==).
# Можно вместо него указать GIGACHAT_CLIENT_ID и GIGACHAT_CLIENT_SECRET.
GIGACHAT_CREDENTIALS=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1

# обычные ответы / квесты и боссы / фото
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_QUEST_MODEL=GigaChat-2-Max
GIGACHAT_VISION_MODEL=GigaChat-2-Pro
# сколько запросов к GigaChat одновременно; если тариф ответит 429, бот сам перейдёт на 1
GIGACHAT_PARALLEL=2
# если пусто, берётся сертификат из certs/
GIGACHAT_CA_BUNDLE_FILE=

DATABASE_PATH=data/bot.sqlite3
LOG_LEVEL=INFO

# ник бота для ссылок; если пусто, узнаётся сам
MAX_BOT_USERNAME=

# веб: порт внутри контейнера (0 — выключить) и адрес, по которому открывается кабинет
WEB_PORT=8080
WEB_BASE_URL=
# для https через caddy, например 203-0-113-10.sslip.io
WEB_DOMAIN=

# MAX ID через запятую, им доступны /stats и страница метрик
ADMIN_IDS=
# сколько готовых квестов держать в запасе; 0 — не готовить заранее
POOL_TARGET=2
